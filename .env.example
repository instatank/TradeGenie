# Anthropic API for transcript structuring (Voice Inbox)
ANTHROPIC_API_KEY=""
# Optional — leave UNSET to use the built-in default (claude-sonnet-5).
# Only set this if you want to override it: claude-haiku-4-5 trades some accuracy
# for lower cost, claude-opus-5 gives maximum quality. An unknown or retired
# model id here makes every capture fall back to plain text — /settings →
# "Test AI connection" will say so.
# ANTHROPIC_MODEL="claude-sonnet-5"

# Firebase Admin for Vercel / production Firestore
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_STORAGE_BUCKET=""

# Optional local development alternative to the three vars above:
# GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/service-account.json"

# Optional — the SignalDesk bridge. When both are set, saving a trade staples a
# frozen snapshot of the market (Fear & Greed, funding, the day's briefing
# headline) onto it. Leave either blank and the feature is simply off: no
# network call, nothing slower, nothing broken. The token must match
# SNAPSHOT_TOKEN in the SignalDesk project.
SIGNALDESK_SNAPSHOT_URL=""
SIGNALDESK_SNAPSHOT_TOKEN=""

# Optional — CoinDCX futures history import (read-only). Generate the key in the
# CoinDCX API dashboard with READ-ONLY permission and bind it to your IP; this
# never needs trade or withdrawal permission. Used by
# `npx tsx scripts/coindcx-probe.ts` and, later, the scheduled trade sync.
COINDCX_API_KEY=""
COINDCX_API_SECRET=""

# Required for the SCHEDULED sync only. Vercel sends cron requests with
# `Authorization: Bearer $CRON_SECRET`, and middleware.ts accepts that in place
# of the site cookie for /api/cron/* — without it the scheduled sync is
# redirected to /login and silently never runs. Any long random string.
# Unset means no exemption at all, never an open door.
CRON_SECRET=""
