# Anthropic API for transcript structuring (Voice Inbox)
ANTHROPIC_API_KEY=""
# Optional — leave UNSET to use the built-in default (claude-sonnet-5).
# Only set this if you want to override it: claude-haiku-4-5 trades some accuracy
# for lower cost, claude-opus-5 gives maximum quality. An unknown or retired
# model id here makes every capture fall back to plain text — /settings →
# "Test AI connection" will say so.
# ANTHROPIC_MODEL="claude-sonnet-5"

# Firebase Admin for Vercel / production Firestore
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_STORAGE_BUCKET=""

# Optional local development alternative to the three vars above:
# GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/service-account.json"
